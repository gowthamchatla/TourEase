        <activity android:name=".BusResultsActivity" android:screenOrientation="portrait" />
        <activity android:name=".CreatePostActivity" />
        <activity android:name=".CommentsActivity" />
        <activity android:name=".UserProfileActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".TransportCostActivity" />
        <activity android:name=".TripResultActivity" />
        <activity android:name=".SearchUsersActivity" />
        <activity android:name=".AccountActivity" />
        <activity android:name=".StaysActivity" />
        <activity android:name=".NearbyPlacesActivity" />


    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="#1A1A2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ROW 1: Bus Name + Rating -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBusName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rajdhani Express Bus"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvOperatorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MSRTC"
                    android:textSize="12sp"
                    android:textColor="#7C7C99"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Bus Type Chip -->
            <TextView
                android:id="@+id/tvBusType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sleeper"
                android:textSize="11sp"
                android:textColor="#6C63FF"
                android:background="@drawable/bg_route_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 4.3"
                android:textSize="13sp"
                android:textColor="#FFD700" />

        </LinearLayout>

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A40"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- ROW 2: Time + Duration + Cities -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Departure -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDepartureTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="06:00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvFromCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delhi"
                    android:textSize="12sp"
                    android:textColor="#7C7C99"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Duration -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26h 00m"
                    android:textSize="12sp"
                    android:textColor="#6C63FF"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="━━━🚌━━━"
                    android:textSize="12sp"
                    android:textColor="#3A3A55"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Arrival -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvArrivalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32:00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvToCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mumbai"
                    android:textSize="12sp"
                    android:textColor="#7C7C99"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Amenities -->
        <TextView
            android:id="@+id/tvAmenities"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WiFi, Charging, Blanket"
            android:textSize="11sp"
            android:textColor="#9999AA"
            android:layout_marginTop="10dp"
            android:drawablePadding="4dp" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A40"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp" />

        <!-- ROW 3: Seat Prices -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Sleeper -->
            <LinearLayout
                android:id="@+id/cardSleeper"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_seat_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLEEPER"
                    android:textSize="9sp"
                    android:textColor="#9999AA"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvSleeperPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹1200"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvSleeperAvail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avl-12"
                    android:textSize="10sp"
                    android:textColor="#00E676"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Semi-Sleeper -->
            <LinearLayout
                android:id="@+id/cardSemiSleeper"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_seat_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEMI-SLPR"
                    android:textSize="9sp"
                    android:textColor="#9999AA"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvSemiSleeperPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹950"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvSemiSleeperAvail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avl-18"
                    android:textSize="10sp"
                    android:textColor="#00E676"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Sitting -->
            <LinearLayout
                android:id="@+id/cardSitting"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:background="@drawable/bg_seat_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SITTING"
                    android:textSize="9sp"
                    android:textColor="#9999AA"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvSittingPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹700"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvSittingAvail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avl-30"
                    android:textSize="10sp"
                    android:textColor="#00E676"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- BOOK BUTTON -->
        <TextView
            android:id="@+id/tvBookBus"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Book Now →"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_book_button" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:background="#1A1A2E"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textSize="15sp"
            android:textColor="#7C7C99"
            android:padding="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnPost"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Post"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6C63FF"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- POST TEXT -->
            <EditText
                android:id="@+id/etPostText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:hint="What's on your travel mind? ✈️"
                android:textColor="#FFFFFF"
                android:textColorHint="#4A4A6A"
                android:textSize="16sp"
                android:gravity="top"
                android:background="@android:color/transparent"
                android:inputType="textMultiLine"
                android:lineSpacingExtra="4dp" />

            <!-- IMAGE PREVIEW -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardImagePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivImagePreview"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="#252540" />

                    <ImageView
                        android:id="@+id/ivRemoveImage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_margin="8dp"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:background="@drawable/bg_circle_translucent"
                        app:tint="#FF5252" />

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="#2A2A40" />

            <!-- LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 ADD LOCATION"
                    android:textSize="12sp"
                    android:textColor="#7C7C99"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:hint="e.g. Goa, Manali, Jaipur..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#4A4A6A"
                    android:textSize="14sp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_input_dark"
                    android:inputType="text"
                    android:maxLines="1" />

            </LinearLayout>

            <!-- VIBE TAGS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="✨ PICK YOUR VIBE"
                android:textSize="12sp"
                android:textColor="#7C7C99"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tagHotTake"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🔥 Hot Take"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagOverrated"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="💀 Overrated"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagHiddenGem"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="💎 Hidden Gem"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tagTouristTrap"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="⚠️ Tourist Trap"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagFoodie"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🍜 Foodie Find"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="💸 Budget Hack"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tagVibes"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🌅 Vibes Only"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagSolo"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🎒 Solo Trip"
                    android:textSize="13sp"
                    android:textColor="#CCCCDD"
                    android:background="@drawable/bg_vibe_tag" />

            </LinearLayout>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:background="#2A2A40" />

            <!-- BOTTOM ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Camera -->
                <ImageView
                    android:id="@+id/ivCamera"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="#6C63FF" />

                <!-- Gallery -->
                <ImageView
                    android:id="@+id/ivGallery"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:layout_marginStart="12dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:background="@drawable/bg_circle_translucent"
                    app:tint="#6C63FF" />

                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="0dp" />

                <!-- Anonymous Toggle -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕶️ Go Anonymous"
                        android:textSize="13sp"
                        android:textColor="#7C7C99" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAnonymous"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
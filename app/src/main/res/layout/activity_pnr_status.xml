<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:background="#1A1A2E"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_circle_translucent"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="PNR Status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PNR INPUT CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#1A1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter 10-digit PNR Number"
                        android:textSize="14sp"
                        android:textColor="#7C7C99" />

                    <EditText
                        android:id="@+id/etPnrNumber"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:hint="e.g. 2124580935"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A4A6A"
                        android:textSize="18sp"
                        android:letterSpacing="0.1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_input_dark"
                        android:inputType="number"
                        android:maxLength="10" />

                    <Button
                        android:id="@+id/btnCheckPnr"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Check Status"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6C63FF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#6C63FF"
                android:visibility="gone" />

            <!-- RESULT CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#1A1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Train Info -->
                    <TextView
                        android:id="@+id/tvPnrTrainName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rajdhani Express"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvPnrTrainNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#12952"
                        android:textSize="13sp"
                        android:textColor="#6C63FF"
                        android:layout_marginTop="4dp" />

                    <!-- Route -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:padding="14dp"
                        android:background="@drawable/bg_input_dark">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FROM"
                                android:textSize="10sp"
                                android:textColor="#7C7C99" />

                            <TextView
                                android:id="@+id/tvPnrFrom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW DELHI"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="→"
                            android:textSize="20sp"
                            android:textColor="#6C63FF"
                            android:layout_gravity="center" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TO"
                                android:textSize="10sp"
                                android:textColor="#7C7C99" />

                            <TextView
                                android:id="@+id/tvPnrTo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MUMBAI CENTRAL"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Journey Details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DATE"
                                android:textSize="10sp"
                                android:textColor="#7C7C99" />

                            <TextView
                                android:id="@+id/tvPnrDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="05-03-2026"
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CLASS"
                                android:textSize="10sp"
                                android:textColor="#7C7C99" />

                            <TextView
                                android:id="@+id/tvPnrClass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3A"
                                android:textSize="14sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHART"
                                android:textSize="10sp"
                                android:textColor="#7C7C99" />

                            <TextView
                                android:id="@+id/tvPnrChart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Not Prepared"
                                android:textSize="14sp"
                                android:textColor="#FF9800"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#2A2A40" />

                    <!-- Passengers Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSENGER STATUS"
                        android:textSize="12sp"
                        android:textColor="#7C7C99"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <!-- Passenger List -->
                    <LinearLayout
                        android:id="@+id/llPassengers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

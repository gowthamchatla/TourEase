<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F1A">

    <!-- TOP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:background="#1A1A2E"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="@drawable/bg_circle_translucent"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Live Train Status"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SEARCH CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#1A1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter Train Number"
                        android:textSize="14sp"
                        android:textColor="#7C7C99" />

                    <EditText
                        android:id="@+id/etTrainNumber"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="12dp"
                        android:hint="e.g. 12952"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A4A6A"
                        android:textSize="18sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_input_dark"
                        android:inputType="number"
                        android:maxLength="5" />

                    <Button
                        android:id="@+id/btnTrackTrain"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Track Train"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#6C63FF"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="14dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#6C63FF"
                android:visibility="gone" />

            <!-- LIVE STATUS CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#1A1A2E">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Train Info -->
                    <TextView
                        android:id="@+id/tvLiveTrainName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rajdhani Express"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvLiveTrainNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="#12952"
                        android:textSize="13sp"
                        android:textColor="#6C63FF"
                        android:layout_marginTop="4dp" />

                    <!-- Current Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:padding="16dp"
                        android:background="@drawable/bg_class_card_green">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT LOCATION"
                            android:textSize="10sp"
                            android:textColor="#7C7C99"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvCurrentStation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RATLAM JN"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#00E676"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvDelayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Running late by 12 min"
                            android:textSize="13sp"
                            android:textColor="#FF9800"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvUpdatedTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Updated: 03:45 AM"
                            android:textSize="11sp"
                            android:textColor="#7C7C99"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#2A2A40" />

                    <!-- Previous Stations -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPLETED STATIONS"
                        android:textSize="11sp"
                        android:textColor="#7C7C99"
                        android:letterSpacing="0.1"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:id="@+id/llPreviousStations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#2A2A40" />

                    <!-- Upcoming Stations -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPCOMING STATIONS"
                        android:textSize="11sp"
                        android:textColor="#7C7C99"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/llUpcomingStations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>

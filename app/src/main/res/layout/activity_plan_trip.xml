<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0A0A14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Status bar spacer — filled programmatically by WindowInsets -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                android:padding="8dp"
                android:background="#1E1E38"
                android:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Your Trip"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="let's cook up something epic ✈️"
                    android:textSize="11sp"
                    android:textColor="#6C63FF" />
            </LinearLayout>

        </RelativeLayout>

        <!-- Origin Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Travelling from?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <AutoCompleteTextView
                android:id="@+id/etOrigin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter your city"
                android:textColorHint="#3D3D5C"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#1E1E38"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="10dp"
                android:inputType="text"
                android:maxLines="1"
                android:completionThreshold="1"
                android:dropDownHeight="wrap_content"
                android:popupBackground="#1E1E38" />
        </LinearLayout>

        <!-- Destination Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Where to?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <AutoCompleteTextView
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Enter destination"
                android:textColorHint="#3D3D5C"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#1E1E38"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="10dp"
                android:inputType="text"
                android:maxLines="1"
                android:completionThreshold="1"
                android:dropDownHeight="wrap_content"
                android:popupBackground="#1E1E38" />
        </LinearLayout>

        <!-- Weather Card — hidden by default, shown when destination is typed -->
        <LinearLayout
            android:id="@+id/cardWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#0D1F3C"
            android:padding="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvWeatherEmoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="☀️"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/tvWeatherCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weather in Goa"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear skies · Great time to visit!"
                    android:textColor="#9B9BB4"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="28°C"
                    android:textColor="#FF6B35"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherSeason"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Best Season ✓"
                    android:textColor="#00C896"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dates Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 When?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <EditText
                android:id="@+id/etDates"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Select dates"
                android:textColorHint="#3D3D5C"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#1E1E38"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="10dp"
                android:focusable="false"
                android:clickable="true" />
        </LinearLayout>

        <!-- Travelers Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥 Who's coming?"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <GridLayout
                android:id="@+id/travelersGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnSolo"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="42dp"
                    android:text="Solo"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnCouple"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="42dp"
                    android:text="Couple"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnFamily"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="42dp"
                    android:text="Family"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnFriends"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_height="42dp"
                    android:text="Friends"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:stateListAnimator="@null" />

            </GridLayout>
        </LinearLayout>

        <!-- Budget Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰 Budget per person"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnBudgetLow"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Broke\nStudent\n₹2K-5K"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:padding="10dp"
                    android:lineSpacingExtra="2dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnBudgetMid"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Got Pocket\nMoney\n₹5K-15K"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:padding="10dp"
                    android:lineSpacingExtra="2dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnBudgetHigh"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Parents\nPaying\n₹15K+"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:background="#1E1E38"
                    android:textColor="#9B9BB4"
                    android:layout_margin="4dp"
                    android:padding="10dp"
                    android:lineSpacingExtra="2dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>
        </LinearLayout>

        <!-- Trip Type Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#12122A"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎪 Trip Type"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#9B9BB4" />

            <GridLayout
                android:id="@+id/tripTypeGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="2"
                android:layout_marginTop="12dp">

                <Button android:id="@+id/btnAdventure" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🏔️ Adventure" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnRelaxation" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🧘 Relaxation" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnSightseeing" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🏛️ Sightseeing" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnRoadTrip" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🚗 Road Trip" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnWeekend" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🌅 Weekend" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />
                <Button android:id="@+id/btnBeach" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="52dp" android:text="🏖️ Beach" android:textSize="11sp" android:textAllCaps="false" android:background="#1E1E38" android:textColor="#9B9BB4" android:layout_margin="4dp" android:stateListAnimator="@null" />

            </GridLayout>
        </LinearLayout>

        <!-- Surprise Me Button -->
        <Button
            android:id="@+id/btnSurpriseMe"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🎲  Surprise Me!"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_surprise_bg"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:stateListAnimator="@null" />

        <!-- Generate Trip Button -->
        <Button
            android:id="@+id/btnGenerateTrip"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="✨  Generate My Trip"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/btn_generate_bg"
            android:textColor="#FFFFFF"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>
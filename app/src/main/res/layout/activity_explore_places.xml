<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Explore Places"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"/>

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <!-- SEARCH BAR -->
        <androidx.cardview.widget.CardView
            android:id="@+id/searchCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search destinations..."
                android:padding="16dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:background="@android:color/transparent"/>

        </androidx.cardview.widget.CardView>

        <!-- CATEGORIES TITLE -->
        <TextView
            android:id="@+id/tvCategoriesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/searchCard"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- CATEGORIES GRID -->
        <GridLayout
            android:id="@+id/categoriesGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="2"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvCategoriesTitle">

            <!-- Mountains -->
            <LinearLayout
                android:id="@+id/btnMountains"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="⛰️"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#E3F2FD"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mountains"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Beaches -->
            <LinearLayout
                android:id="@+id/btnBeaches"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🏖️"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#FFF3E0"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beaches"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Heritage -->
            <LinearLayout
                android:id="@+id/btnHeritage"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🏛️"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#F3E5F5"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heritage"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Nature -->
            <LinearLayout
                android:id="@+id/btnNature"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🌳"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#E8F5E9"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nature"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Spiritual -->
            <LinearLayout
                android:id="@+id/btnSpiritual"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🕉️"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#FFF9C4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Spiritual"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Adventure -->
            <LinearLayout
                android:id="@+id/btnAdventure"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🎿"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#FFEBEE"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adventure"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Food -->
            <LinearLayout
                android:id="@+id/btnFood"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🍛"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#FCE4EC"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Shopping -->
            <LinearLayout
                android:id="@+id/btnShopping"
                android:layout_width="0dp"
                android:layout_columnWeight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="🛍️"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:background="#E1F5FE"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopping"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </GridLayout>

        <!-- TRENDING PLACES TITLE -->
        <TextView
            android:id="@+id/tvTrendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trending Destinations"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/categoriesGrid"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/tripsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTrendingTitle"/>



    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
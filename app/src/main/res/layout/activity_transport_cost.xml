<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_revert"
                android:padding="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Transport Costs"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

        </RelativeLayout>

        <!-- Route Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_rounded_bg"
            android:padding="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:elevation="2dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chennai → Goa"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="890 km"
                android:textSize="15sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Best Value Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_surprise_bg"
            android:padding="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvBestValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚂 Train (AC 3-tier) — best value for money"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Train Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_rounded_bg"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚂 Train"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <!-- Sleeper -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sleeper"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTrainSleeperTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14h 30m"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrainSleeper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹830"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

            <!-- AC 3-Tier -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC 3-Tier"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTrainAC3Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13h 15m"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrainAC3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹1,450"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

            <!-- AC 2-Tier -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AC 2-Tier"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvTrainAC2Time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13h 15m"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvTrainAC2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹1,990"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

        </LinearLayout>

        <!-- Bus Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_rounded_bg"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚌 Bus"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <!-- Govt Bus -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Govt / KSRTC"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvBusGovtTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16h"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBusGovt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹1,170"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

            <!-- Private Bus -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private / Volvo"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvBusPrivateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14h"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvBusPrivate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹1,700"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

        </LinearLayout>

        <!-- Flight Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_rounded_bg"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️ Flight"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Economy"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvFlightTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h 30m"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvFlight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹5,500"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

        </LinearLayout>

        <!-- Auto/Cab Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_rounded_bg"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛺 Auto / Cab"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/edittext_rounded_bg"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ola / Uber / Local"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvAutoCabTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12h"
                        android:textSize="12sp"
                        android:textColor="#999999"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAutoCab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="₹12,500"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"/>

            </RelativeLayout>

        </LinearLayout>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="* Estimates based on average rates. Actual prices may vary by season, availability, and booking platform."
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>